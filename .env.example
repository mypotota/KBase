# Set this securely before starting the sync service. Do not commit .env.
KBASE_ADMIN_PASSWORD=
# Add the exact HTTPS origin when exposing the web client on your own domain.
KBASE_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost,http://localhost:8080,http://127.0.0.1:8080
# Optional: configure DNS and use docker compose --profile https up -d --build.
KBASE_DOMAIN=knowledge.example.com
